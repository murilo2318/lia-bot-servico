# Copie para .env (NUNCA suba o .env para o GitHub)

# Chave que o frontend envia no header X-API-Key
API_KEY=troque-esta-chave

# Provedor do modelo: gemini | groq | mock (mock roda sem chave, sem internet e sem custo)
LLM_PROVIDER=groq
GEMINI_API_KEY=
# Prefira versões fixas: um alias "-latest" troca de modelo (e de cota) sem avisar
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comportamento
PROMPT_VERSION=v2
HISTORY_WINDOW_TURNS=6
SUMMARY_ENABLED=true
NLU_LLM_FALLBACK=true
MAX_INPUT_CHARS=500
MAX_OUTPUT_CHARS=700
LLM_TIMEOUT_S=30

# Resiliência: novas tentativas em 503/429/timeout e provedor reserva
# (se o Groq falhar, a mesma chamada vai para o Gemini, se houver GEMINI_API_KEY)
LLM_RETRIES=1
LLM_RETRY_WAIT_S=1.5
LLM_FALLBACK_PROVIDER=gemini
